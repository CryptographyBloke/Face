PORT=8787
APP_ORIGIN=http://localhost:8787
FACE_DB_PATH=data/face.sqlite
FACE_READ_ONLY=false
# Optional trusted Ethereum RPC. Never use a VITE_ prefix for server secrets.
ENS_RPC_URL=

# Face Copilot v0.5: public tools work with AI execution off.
FACE_AI_ENABLED=false
FACE_AI_PROVIDER=newapi
NEWAPI_BASE_URL=http://82.156.218.54/v1
# Explicit opt-in for this owner-specified HTTP endpoint. Prefer HTTPS when available.
NEWAPI_ALLOW_HTTP=true
NEWAPI_API_KEY=
NEWAPI_MODEL=gpt-6.1-sol
# Verified candidate; choose an exact Gateway model server-side.
AI_GATEWAY_MODEL=alibaba/qwen3.7-flash
# Vercel deployments may use injected VERCEL_OIDC_TOKEN instead.
AI_GATEWAY_API_KEY=
# Owner-controlled beta only, at least 32 characters; enter through Vercel secrets.
FACE_AI_BETA_TOKEN=
# Existing shared Upstash Redis HTTPS REST endpoint and scoped token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
