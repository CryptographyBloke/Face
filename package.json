{
  "name": "wallet-face",
  "version": "0.4.0",
  "description": "Wallet profiles and public community participation infrastructure",
  "type": "module",
  "bin": {
    "ens-dns-bootstrap": "./src/cli.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "dev:api": "node --watch server/index.mjs",
    "build": "npm --prefix web run build",
    "test:protocol": "npm --prefix web run test:protocol",
    "start": "node server/index.mjs",
    "dev": "node --env-file-if-exists=.env.local server/index.mjs",
    "smoke": "node scripts/smoke.mjs",
    "legacy:cli": "node src/cli.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "keywords": [
    "ens",
    "dnssec",
    "cloudflare",
    "ethereum",
    "web3"
  ],
  "dependencies": {
    "viem": "^2.57.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.6.2",
    "react": "^19.3.1",
    "typescript": "^5.9.3"
  }
}
